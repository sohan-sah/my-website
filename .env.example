# Server-side only. Never prefix with NEXT_PUBLIC_ — that would ship it to the browser.
# Get a token at https://huggingface.co/settings/tokens (Read access is enough).
HF_TOKEN=

# Optional: override the background-removal model/endpoint.
# Default is briaai/RMBG-1.4 (non-commercial license — see README).
HF_BG_REMOVAL_MODEL=briaai/RMBG-1.4
