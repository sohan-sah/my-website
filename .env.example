# Copy this file to .env for local development (never commit the real .env).
# On Vercel/Render, paste these into the platform's dashboard instead.

# Required — get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — override which HF model each UI option tries FIRST.
# Each feature also has a built-in fallback chain in server/app.js, since
# Hugging Face's free hf-inference provider changes model coverage over
# time. Leave these unset to just use the built-in fallbacks.
HF_MODEL_T2I_NOVA=stabilityai/stable-diffusion-xl-base-1.0
HF_MODEL_T2I_APERTURE=stabilityai/stable-diffusion-xl-base-1.0
HF_MODEL_T2I_SKETCHLINE=runwayml/stable-diffusion-v1-5
HF_MODEL_T2I_REAL8K=black-forest-labs/FLUX.1-schnell
HF_MODEL_BG_REMOVAL=briaai/RMBG-1.4
HF_MODEL_UPSCALE=stabilityai/stable-diffusion-x4-upscaler

# Local dev only — ignored on Vercel (which sets PORT itself)
PORT=3000
